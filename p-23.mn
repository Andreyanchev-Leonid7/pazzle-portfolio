// 1 Задание

string directoryPath = "data";
try
{
    Directory.CreateDirectory(directoryPath);
    Console.WriteLine($"Каталог '{directoryPath}' создан или уже существует.");
    string filePath = Path.Combine(directoryPath, $"file.txt");
    Console.WriteLine($"Создан файл: file.txt");
    File.WriteAllText(Path.Combine(directoryPath, "not_text.docx"), "Это не текстовый файл");
    
    var txtFiles = Directory.GetFiles(directoryPath, "*.txt");
    foreach (string file in txtFiles)
    {
        FileInfo fileInfo = new FileInfo(file);
        Console.WriteLine($"Файл: {fileInfo.Name}, Размер: {fileInfo.Length} байт");
    }
}
catch (Exception ex)
{
    Console.WriteLine($"Произошла ошибка: {ex.Message}");
}

// 2 Задание

Console.Write("Введите путь к файлу для создания резервной копии: ");
string filePath = Console.ReadLine();

try
{
    if (File.Exists(filePath))
    {
        FileInfo fileInfo = new FileInfo(filePath);
        string backupPath = filePath + ".bak";
        if (File.Exists(backupPath))
        {
            string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            backupPath = filePath + $".{timestamp}.bak";
            Console.WriteLine($"Файл резервной копии уже существует. Будет создан: {Path.GetFileName(backupPath)}");
        }
        File.Copy(filePath, backupPath);
        Console.WriteLine("\n✓ Резервная копия успешно создана!");
        Console.WriteLine($"Исходный файл: {filePath}");
        Console.WriteLine($"Резервная копия: {backupPath}");
        Console.WriteLine($"Размер файла: {fileInfo.Length} байт");
        Console.WriteLine($"Время создания копии: {DateTime.Now}");
    }
    else
    {
        Console.WriteLine($"\n❌ Ошибка: Файл '{filePath}' не существует!");
        Console.WriteLine("Проверьте правильность пути и попробуйте снова.");
    }
}
catch (UnauthorizedAccessException)
{
    Console.WriteLine("\n❌ Ошибка доступа: Нет прав для чтения/записи файла.");
}
catch (PathTooLongException)
{
    Console.WriteLine("\n❌ Ошибка: Слишком длинный путь к файлу.");
}
catch (IOException ex)
{
    Console.WriteLine($"\n❌ Ошибка ввода-вывода: {ex.Message}");
}
catch (Exception ex)
{
    Console.WriteLine($"\n❌ Непредвиденная ошибка: {ex.Message}");
}

// 3 Задание

class Book
{
    public string Title { get; set; }
    public string Author { get; set; }

    public Book(string title, string author)
    {
        Title = title;
        Author = author;
    }

    public override string ToString()
    {
        return $"Название: {Title}, Автор: {Author}";
    }
}
static List<Book> books = new List<Book>();
    const string fileName = "books.txt";
    static void Main(string[] args)
    {
        LoadBooksFromFile();
        while (true)
        {
            Console.WriteLine("\n--- Меню ---");
            Console.WriteLine("1. Добавить книгу");
            Console.WriteLine("2. Показать все книги");
            Console.WriteLine("3. Выход");
            Console.Write("Выберите действие: ");
            string choice = Console.ReadLine();
            switch (choice)
            {
                case "1":
                    AddBook();
                    break;
                case "2":
                    ShowAllBooks();
                    break;
                case "3":
                    SaveBooksToFile();
                    Console.WriteLine("Программа завершена. До свидания!");
                    return;
                default:
                    Console.WriteLine("Неверный выбор. Пожалуйста, выберите 1, 2 или 3.");
                    break;
            }
        }
    }
    static void AddBook()
    {
        Console.Write("Введите название книги: ");
        string title = Console.ReadLine();

        Console.Write("Введите автора книги: ");
        string author = Console.ReadLine();

        if (!string.IsNullOrWhiteSpace(title) && !string.IsNullOrWhiteSpace(author))
        {
            books.Add(new Book(title, author));
            Console.WriteLine("Книга успешно добавлена!");
            SaveBooksToFile(); // Сохраняем сразу после добавления
        }
        else
        {
            Console.WriteLine("Название и автор не могут быть пустыми!");
        }
    }
    static void ShowAllBooks()
    {
        if (books.Count == 0)
        {
            Console.WriteLine("Список книг пуст.");
            return;
        }

        Console.WriteLine("\n--- Список книг ---");
        for (int i = 0; i < books.Count; i++)
        {
            Console.WriteLine($"{i + 1}. {books[i]}");
        }
    }

    static void SaveBooksToFile()
    {
        try
        {
            using (StreamWriter writer = new StreamWriter(fileName))
            {
                foreach (Book book in books)
                {
                    writer.WriteLine($"{book.Title};{book.Author}");
                }
            }
            Console.WriteLine("Список книг сохранен в файл.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при сохранении в файл: {ex.Message}");
        }
    }

    static void LoadBooksFromFile()
    {
        try
        {
            if (File.Exists(fileName))
            {
                string[] lines = File.ReadAllLines(fileName);
                books.Clear();

                foreach (string line in lines)
                {
                    if (!string.IsNullOrWhiteSpace(line))
                    {
                        string[] parts = line.Split(';');
                        if (parts.Length == 2)
                        {
                            books.Add(new Book(parts[0], parts[1]));
                        }
                    }
                }
                Console.WriteLine($"Загружено {books.Count} книг из файла.");
            }
            else
            {
                Console.WriteLine("Файл с книгами не найден. Будет создан новый список.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке из файла: {ex.Message}");
        }