// 1 Задание
int[] numbers = { -5, 2, 3, -4, 6, 7, -8, 10, 0, 12, -3, 4 };
var result = numbers
    .Where(n => n > 0 && n % 2 == 0)  
    .Select(n => n * n)            
    .ToList();                      
int count = result.Count;
if (count > 0)
{
    int sum = result.Sum();
    double average = result.Average();
    Console.WriteLine("Исходный массив: " + string.Join(", ", numbers));
    Console.WriteLine("Положительные чётные числа, возведённые в квадрат: " + string.Join(", ", result));
    Console.WriteLine($"Сумма: {sum}");
    Console.WriteLine($"Количество: {count}");
    Console.WriteLine($"Среднее арифметическое: {average:F2}");
}
else
{
    Console.WriteLine("В массиве нет положительных чётных чисел");
}
// 2 Задание
List<string> words = new List<string>
        {
            "яблоко",
            "Арбуз",
            "апельсин",
            "Банан",
            "ананас",
            "Груша",
            "Абрикос",
            "арбуз",      
            "Апельсин",   
            "вишня",
            "Айва",
            "автомобиль"
        };
var result = words
    .Where(w => !string.IsNullOrEmpty(w) && w.StartsWith("а", StringComparison.OrdinalIgnoreCase))  
    .Select(w => w.ToUpper())                                                                        
    .Distinct()                                                                                      
    .OrderBy(w => w.Length)                                                                          
    .ToList();
foreach (var word in words)
{
    Console.WriteLine($"  {word}");
}
if (result.Any())
{
    foreach (var word in result)
    {
        Console.WriteLine($"  {word} (длина: {word.Length})");
    }

    Console.WriteLine($"\nВсего уникальных слов: {result.Count}");
}
else
{
    Console.WriteLine("  Слова на букву 'А/а' не найдены");
}