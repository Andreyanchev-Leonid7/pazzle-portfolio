// 1 Задание
int[] numbers = { -5, 2, 3, -4, 6, 7, -8, 10, 0, 12, -3, 4 };
var result = numbers
    .Where(n => n > 0 && n % 2 == 0)  
    .Select(n => n * n)            
    .ToList();                      
int count = result.Count;
if (count > 0)
{
    int sum = result.Sum();
    double average = result.Average();
    Console.WriteLine("Исходный массив: " + string.Join(", ", numbers));
    Console.WriteLine("Положительные чётные числа, возведённые в квадрат: " + string.Join(", ", result));
    Console.WriteLine($"Сумма: {sum}");
    Console.WriteLine($"Количество: {count}");
    Console.WriteLine($"Среднее арифметическое: {average:F2}");
}
else
{
    Console.WriteLine("В массиве нет положительных чётных чисел");
}